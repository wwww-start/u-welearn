{
  "manifest_version": 3,
  "name": "AI自动答题助手",
  "version": "1.5.0",
  "description": "题目识别、多选与听力处理、学习时长辅助、学习通刷课与答题",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "declarativeNetRequest",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://uai.unipus.cn/*",
        "https://ucontent.unipus.cn/*",
        "https://ucloud.unipus.cn/*",
        "https://ipub.unipus.cn/*",
        "https://welearn.sflep.com/*",
        "https://centercourseware.sflep.com/*"
      ],
      "all_frames": true,
      "js": [
        "modules/site-matcher.js",
        "modules/template-manager.js",
        "modules/bank.js",
        "modules/unipus-page-model.js",
        "modules/scanner-enhanced.js",
        "modules/unipus-api.js",
        "modules/welearn-api.js",
        "modules/flow-policy.js",
        "modules/welearn-controller.js",
        "modules/answer-tools.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    },
    {
      "matches": [
        "https://ucontent.unipus.cn/*",
        "https://ipub.unipus.cn/*"
      ],
      "all_frames": true,
      "run_at": "document_end",
      "js": [
        "modules/unipus-auto-player.js"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": false,
      "run_at": "document_idle",
      "js": [
        "modules/xuexitong-page-model.js",
        "modules/xuexitong-legacy.js",
        "modules/xuexitong-ai.js",
        "modules/xuexitong-video.js",
        "modules/xuexitong-answer.js",
        "modules/xuexitong-exam.js",
        "modules/xuexitong-entry.js"
      ]
    },
    {
      "matches": [
        "https://*.chaoxing.com/ananas/modules/video/*",
        "https://*.xuexitong.com/ananas/modules/video/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN",
      "js": [
        "modules/xuexitong-video-guard.js"
      ]
    },
    {
      "matches": [
        "https://stat2-ans.chaoxing.com/*"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "modules/xuexitong-coze-hook.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "templates/*.json"
      ],
      "matches": [
        "https://uai.unipus.cn/*",
        "https://ucontent.unipus.cn/*",
        "https://ucloud.unipus.cn/*",
        "https://ipub.unipus.cn/*",
        "https://welearn.sflep.com/*",
        "https://centercourseware.sflep.com/*",
        "https://*.chaoxing.com/*",
        "https://*.xuexitong.com/*"
      ]
    },
    {
      "resources": [
        "modules/xuexitong-video-guard.js"
      ],
      "matches": [
        "https://*.chaoxing.com/*",
        "https://*.xuexitong.com/*"
      ]
    }
  ]
}
